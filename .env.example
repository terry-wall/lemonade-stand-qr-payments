# Stripe secret key — https://dashboard.stripe.com/apikeys
# No publishable key is needed: payment happens on Stripe's hosted Checkout page.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the /api/webhook endpoint.
# Locally: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Absolute, publicly reachable base URL. Stripe redirects back here after
# checkout, so it must be a URL the phone scanning the QR code can reach —
# not localhost, unless you are testing on the same machine.
APP_URL=http://localhost:3000

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lemonade_stand
