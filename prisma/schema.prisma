generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                String   @id @default(cuid())
  checkoutSessionId String   @unique
  /// Priced order lines: [{ id, name, quantity, unitPriceCents }]
  items             Json
  /// Order total in cents. Integer, never a float.
  amountCents       Int
  /// One of: pending | completed | failed | expired
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@map("orders")
}
